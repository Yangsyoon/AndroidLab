<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_green"
    android:layout_marginTop="26dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="364dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/detect_bg"
        android:gravity="center_vertical"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_detective"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/detective_cat2"
            android:contentDescription="@string/detective_image" />

        <TextView
            android:id="@+id/text_detective_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:text="나는 감정 탐정!"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 연습하기 카드 -->
    <FrameLayout
        android:id="@+id/button_practice"
        android:layout_width="330dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_test"
        app:layout_constraintHeight_percent="0.4"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/detective_practice_bg4"
            android:scaleType="fitXY"
            android:adjustViewBounds="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="연습하기"
            android:textSize="25sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black"
            android:gravity="center" />
    </FrameLayout>

    <!-- 시험치기 카드 -->
    <FrameLayout
        android:id="@+id/button_test"
        android:layout_width="330dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/button_practice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintHeight_percent="0.4"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/detective_test_bg3"
            android:scaleType="fitXY"
            android:adjustViewBounds="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="시험치기"
            android:textSize="25sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black"
            android:gravity="center" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
