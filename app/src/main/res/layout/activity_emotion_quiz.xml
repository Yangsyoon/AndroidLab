<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_detective"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/detective_bg"
        android:text="시험 모드"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- 문제 이미지 + 결과 아이콘 + 정답 메시지 겹치기 위해 FrameLayout 사용 -->
    <!-- 문제 이미지 + 정답 결과 오버레이 표시 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6">

        <!-- 이미지 프레임 (액자 효과) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/frame_softgreen2_border"
            android:padding="16dp">

            <ImageView
                android:id="@+id/image_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="문제 이미지"
                android:src="@drawable/test_surprised_sample1" />
        </FrameLayout>

        <!-- 정답 결과 오버레이 카드 -->
        <LinearLayout
            android:id="@+id/result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_result_card"
            android:visibility="gone"
            android:elevation="10dp">

            <ImageView
                android:id="@+id/image_result_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="정답 아이콘" />

            <TextView
                android:id="@+id/text_result_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정답은 기쁨입니다!"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/text_question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 10  문제"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 감정 버튼 영역 (2x2 배치) -->
    <GridLayout
        android:id="@+id/grid_emotion_buttons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:padding="8dp"
        android:rowOrderPreserved="false"
        android:useDefaultMargins="true">

        <!-- 기쁨 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/button_bg"
            android:onClick="onEmotionClicked"
            android:clickable="true"
            android:focusable="true"
            android:tag="기쁨">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/happy_icon2"
                android:contentDescription="기쁨 이미지" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기쁨"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 슬픔 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/button_bg"
            android:onClick="onEmotionClicked"
            android:clickable="true"
            android:focusable="true"
            android:tag="슬픔">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/sad_icon2"
                android:contentDescription="슬픔 이미지" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="슬픔"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 화남 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/button_bg"
            android:onClick="onEmotionClicked"
            android:clickable="true"
            android:focusable="true"
            android:tag="화남">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/angry_icon2"
                android:contentDescription="화남 이미지" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="화남"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 놀람 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/button_bg"
            android:onClick="onEmotionClicked"
            android:clickable="true"
            android:focusable="true"
            android:tag="놀람">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/surprised_icon2"
                android:contentDescription="놀람 이미지" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="놀람"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </GridLayout>

    <!-- 정답 확인 버튼 -->
    <Button
        android:id="@+id/btn_check_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="정답 확인"
        android:layout_marginTop="12dp" />

</LinearLayout>
