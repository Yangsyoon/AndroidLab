<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="24dp"
    android:layout_marginTop="26dp">

    <!-- 카드 배경 이미지 -->
    <ImageView
        android:id="@+id/score_board"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/score_board"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 중앙 상단 텍스트 -->
    <TextView
        android:id="@+id/score_board_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="@id/score_board"
        app:layout_constraintBottom_toBottomOf="@id/score_board"
        app:layout_constraintStart_toStartOf="@id/score_board"
        app:layout_constraintEnd_toEndOf="@id/score_board"
        app:layout_constraintVertical_bias="0.18"
        app:layout_constraintHorizontal_bias="0.83" />

    <!-- 왼쪽 아래 텍스트 -->
    <TextView
        android:id="@+id/detective_score_board_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        app:layout_constraintTop_toTopOf="@id/score_board"
        app:layout_constraintBottom_toBottomOf="@id/score_board"
        app:layout_constraintStart_toStartOf="@id/score_board"
        app:layout_constraintEnd_toEndOf="@id/score_board"
        app:layout_constraintVertical_bias="0.85"
        app:layout_constraintHorizontal_bias="0.22" />

    <!-- 오른쪽 아래 텍스트 -->
    <TextView
        android:id="@+id/facial_score_board_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        app:layout_constraintTop_toTopOf="@id/score_board"
        app:layout_constraintBottom_toBottomOf="@id/score_board"
        app:layout_constraintStart_toStartOf="@id/score_board"
        app:layout_constraintEnd_toEndOf="@id/score_board"
        app:layout_constraintVertical_bias="0.85"
        app:layout_constraintHorizontal_bias="0.78" />

    <!-- 첫 번째 버튼 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_goToTestScore"
        android:layout_width="0dp"
        android:layout_height="246dp"
        android:background="@drawable/detective_score_card2"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/score_board"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 두 번째 버튼 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_goToMyFaceScore"
        android:layout_width="0dp"
        android:layout_height="246dp"
        android:background="@drawable/facial_score_card2"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/btn_goToTestScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
