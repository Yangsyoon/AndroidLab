<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom|center"
    android:paddingBottom="24dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="20dp">

        <!-- 카드 배경 이미지 -->
        <ImageView
            android:id="@+id/score_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/score_board" />

        <!-- 겹치는 텍스트 (하얀 공간에 맞춰 배치) -->
        <TextView
            android:id="@+id/score_board_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="195dp"
            android:layout_marginTop="43dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:text="승호의\n 최근점수야!"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/detective_score_board_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="224dp"
            android:layout_marginEnd="210dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:text="100점"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black"
            android:textSize="28sp" />
        <TextView
            android:id="@+id/facial_score_board_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="206dp"
            android:layout_marginTop="224dp"
            android:layout_marginEnd="23dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:text="80점"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black"
            android:textSize="28sp" />
    </FrameLayout>

        <!-- 첫 번째 버튼 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_goToTestScore"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/detective_score_card"
        android:clickable="true"
        android:focusable="true">

    <!-- 내부 요소 생략 -->
    </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 두 번째 버튼 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_goToMyFaceScore"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/facial_score_card"
        android:clickable="true"
        android:focusable="true">

    <!-- 내부 요소 생략 -->
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
