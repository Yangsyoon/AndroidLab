<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_detective"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/detective_bg"
        android:text="연습 모드"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 감정 사진: 화면 높이의 3/4 크기 -->
    <!-- 문제 이미지 -->
    <FrameLayout
        android:id="@+id/frame_emotion_image"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/frame_softgreen2_border"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/button_detective"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">  <!-- 액자 두께만큼 패딩 -->

        <ImageView
            android:id="@+id/image_emotion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="문제 이미지"
            android:src="@drawable/test_surprised_sample1" />

    </FrameLayout>

    <!-- 정답 감정 텍스트 -->
    <TextView
        android:id="@+id/text_emotion_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정답: 기쁨"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/frame_emotion_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 다음 사진 버튼 -->

    <!-- 연습 완료 버튼 -->

    <Button
        android:id="@+id/btn_next_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="148dp"
        android:background="@drawable/frame_5"
        android:text="다음 사진 보기"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_emotion_answer" />

    <Button
        android:id="@+id/button_finish_practice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/frame_5"
        android:text="연습 완료"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_next_image" />

</androidx.constraintlayout.widget.ConstraintLayout>
