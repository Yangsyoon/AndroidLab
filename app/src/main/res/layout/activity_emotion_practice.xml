<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/soft_green2"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_detective"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/detective_cat2"
            android:contentDescription="@string/detective_image" />

        <TextView
            android:id="@+id/text_detective_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나는 감정 탐정!"
            android:textSize="22sp"
            android:textColor="#000000"
            android:layout_marginStart="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 감정 사진: 화면 높이의 3/4 크기 -->
    <ImageView
        android:id="@+id/image_emotion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="감정 사진"
        android:src="@drawable/test_happy_sample1"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        android:layout_marginTop="16dp"/>

    <!-- 정답 감정 텍스트 -->
    <TextView
        android:id="@+id/text_emotion_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="감정: 기쁨"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/image_emotion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 다음 사진 버튼 -->
    <Button
        android:id="@+id/btn_next_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="다음 사진 보기"
        android:background="@drawable/frame_5"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_emotion_answer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 연습 완료 버튼 -->
    <Button
        android:id="@+id/button_finish_practice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="연습 완료"
        android:background="@drawable/frame_5"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_next_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
