<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/detect_bg"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_detective"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/detective_cat2"
            android:contentDescription="@string/detective_image" />

        <TextView
            android:id="@+id/text_detective_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나는 감정 탐정!"
            android:textSize="22sp"
            android:textColor="#000000"
            android:layout_marginStart="36dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 감정 사진: 화면 높이의 3/4 크기 -->
    <ImageView
        android:id="@+id/image_emotion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:contentDescription="감정 사진"
        android:src="@drawable/test_happy_sample1"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        android:layout_marginTop="16dp"/>


    <!-- 감정 텍스트 + 아이콘 (가로 정렬) -->
    <LinearLayout
        android:id="@+id/emotion_answer_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/image_emotion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_emotion_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="감정: 기쁨"
            android:textSize="24sp"
            android:textColor="@android:color/black" />

        <ImageView
            android:id="@+id/image_emotion_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/happy_icon2"
            android:contentDescription="@string/detective_image"/>
    </LinearLayout>

    <!-- 다음 사진 버튼 -->
    <FrameLayout
        android:id="@+id/button_next_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/emotion_answer_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 배경 이미지 버튼 -->
        <ImageButton
            android:id="@+id/button_next_practice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/detect_bg"
            android:scaleType="fitXY"
            android:background="@null" />

        <!-- 중앙 텍스트 -->
        <TextView
            android:id="@+id/button_next_practice_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="다음 사진 보기"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black" />
    </FrameLayout>

    <!-- // 변경: 연습 완료 → FrameLayout(이미지 + 텍스트 오버레이) -->
    <FrameLayout
        android:id="@+id/button_practice_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/button_next_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 배경 이미지 버튼 -->
        <ImageButton
            android:id="@+id/button_finish_practice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/detect_bg"
            android:scaleType="fitXY"
            android:background="@null" />

        <!-- 중앙 텍스트 -->
        <TextView
            android:id="@+id/button_finish_practice_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="연습 완료"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/black" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>